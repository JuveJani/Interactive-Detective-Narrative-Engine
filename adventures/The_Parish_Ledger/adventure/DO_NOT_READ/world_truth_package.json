      },
      {
        "fact_id": "FACT-008",
        "statement": "Grace Brennan signed deposit batch without required second counter-signature"
      },
      {
        "fact_id": "FACT-009",
        "statement": "Father Michael O'Sullivan was told memorial fund was fully deposited on March 11"
      },
      {
        "fact_id": "FACT-010",
        "statement": "Rita Santos requested duplicate deposit receipts but Grace said they were already filed"
      },
      {
        "fact_id": "FACT-011",
        "statement": "Memorial register entries 112 through 118 do not appear in the bank deposit batch"
      },
      {
        "fact_id": "FACT-012",
        "statement": "Grace Brennan's badge log shows records room access at 2230 on March 11"
      },
      {
        "fact_id": "FACT-013",
        "statement": "Grace Brennan faced overdue property tax pressure documented in her office files"
      },
      {
        "fact_id": "FACT-014",
        "statement": "Counter-signature log shows Grace self-signed as both preparer and verifier"
      }
