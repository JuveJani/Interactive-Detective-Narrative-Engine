  "fixed_truth": {
    "culprit_id": "NPC-TOM",
    "motive": "Avoid commission discipline and negligence findings after Henry died during unauthorized lens repair Tom had warned against",
    "method": "Discovered Henry's body after a gallery fall, then falsified voluntary-departure entries in the log book and radio traffic",
    "opportunity": "Acting keeper on watch; access to log book, radio terminal, and supply tally signatures",
    "immutable_facts": [
      {
        "fact_id": "FACT-001",
        "statement": "Head keeper Henry Walsh planned unauthorized lens shim calibration alone in the gallery at 0400"
      },
      {
        "fact_id": "FACT-002",
        "statement": "Henry Walsh fell from the gallery safety railing during lens repair"
      },
      {
        "fact_id": "FACT-003",
        "statement": "Assistant keeper Tom Reed discovered Henry's body in the gallery"
      },
      {
        "fact_id": "FACT-004",
        "statement": "Tom Reed staged a voluntary-departure narrative to avoid commission scrutiny"
      },
      {
        "fact_id": "FACT-005",
        "statement": "Tom Reed logged voluntary departure at 0430 in the keeper's log book"
      },
      {
        "fact_id": "FACT-006",
        "statement": "Tom Reed keyed a voluntary-departure radio report at 0410 under Henry's name"
      },
      {
        "fact_id": "FACT-007",
        "statement": "Landing operations were closed from 0345 to 0715 due to squall conditions"
      },
      {
        "fact_id": "FACT-008",
        "statement": "Pilot Frank Morales flew no passenger off the station during the night"
      },
      {
        "fact_id": "FACT-009",
        "statement": "Henry Walsh's personal trunk TRK-HENRY-014 never scanned outbound"
      },
      {
        "fact_id": "FACT-010",
        "statement": "Gallery railing shows fresh scrape marks and a bent rail pin at the lens access point"
      },
      {
        "fact_id": "FACT-011",
        "statement": "Lens toolkit LSK-7 was checked out to Henry for scheduled service two days earlier"
      },
      {
        "fact_id": "FACT-012",
        "statement": "Relief keeper Sarah Chen was not told the true status of Henry Walsh before arrival"
      },
      {
        "fact_id": "FACT-013",
        "statement": "Supply clerk Maya Ortiz records show Tom signed the 0430 outbound tally without Henry's signature"
      },
      {
        "fact_id": "FACT-014",
        "statement": "Weather chart CLOSED status contradicts any claimed 0430 voluntary boat or rotor departure"
      }
    ]
  },
