      { "fact_id": "FACT-011", "statement": "High-temperature alarm ALM-COLD-HIGH activated at 23:30" },
      { "fact_id": "FACT-012", "statement": "Lori entered cold storage to hide the L-4471 short-ship before audit sampling" },
      { "fact_id": "FACT-013", "statement": "Cleaning lead Pat Nguyen saw the dock door propped and an unidentified person near the cold hall at 23:40 without seeing a face" },
      { "fact_id": "FACT-014", "statement": "The nightly badge log batch upload to the access archive completed at 02:30 due to standard IT sync delay" },
      { "fact_id": "FACT-015", "statement": "If CZ-1 remains above -12C at 05:00, Northline must initiate product write-off and health compliance notification" },
      { "fact_id": "FACT-016", "statement": "Lori intended only to relabel pallets and silence a local door alarm, not to disable refrigeration" },
      { "fact_id": "FACT-017", "statement": "Root cause of product risk is the unattended BMS override, not the label swap alone" }
