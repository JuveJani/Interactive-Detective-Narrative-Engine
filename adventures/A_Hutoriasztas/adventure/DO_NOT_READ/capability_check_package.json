      "exposes_failure_content": false
    },
    {
      "unit_id": "UNIT-LABEL-SUCCESS",
      "player_text": "A C folyosó mentén friss ragasztónyomot tartalmazó címkehátlap csíkot kap vissza."
    },
    {
      "unit_id": "UNIT-LABEL-FAIL",
      "player_text": "A padló és a raklap felülete rutinszerű raktári kopást mutat; semmi jellegzetes nyoma nem látszik.",
