      { "fact_id": "FACT-003", "statement": "Dev's temporary badge BADGE-DEV-TEMP remained in the break room locker after he departed" },
      { "fact_id": "FACT-004", "statement": "Night guard Marcus Hale visually confirmed the cold storage door latch engaged at 23:00" },
      { "fact_id": "FACT-005", "statement": "The cold storage badge reader logged an inbound entry at 23:14:08 using credential BADGE-DEV-TEMP" },
      { "fact_id": "FACT-006", "statement": "Lori removed label LBL-4471-A (serial NL-20260312-4471A) from 8-case partial pallet PLT-4471-A and label LBL-Q118-B from quarantine pallet PLT-Q118-B, then affixed LBL-4471-A to PLT-Q118-B (48 cases) and LBL-Q118-B to the 8-case partial stack so WMS scans would show L-4471 full at bay C3 while the short-ship sat under quarantine label" },
      { "fact_id": "FACT-007", "statement": "Lori Okonkwo's badge BADGE-LORI logged door entry to the automation control room at 23:20:41 but Lori holds no REFRG_TECH engineering privilege" },
      { "fact_id": "FACT-008", "statement": "BMS terminal CTRL-TERM-02 logged command CMD-CZ1-MUTE-STAGE at 23:22:17 under maintenance session SVC-REFRG-MAINT; the command log records terminal and session only, not the operator's personal badge" },
      { "fact_id": "FACT-009", "statement": "CMD-CZ1-MUTE-STAGE suspends CZ-1 demand staging and compressor rotation while muting door-ajar annunciation for the selected zone test window" },
      { "fact_id": "FACT-010", "statement": "CZ-1 supply air temperature began a sustained rise at 23:27 after staging suspension while thermal mass masked early drift" },
      { "fact_id": "FACT-011", "statement": "High-temperature alarm ALM-COLD-HIGH activated at 23:30 when CZ-1 supply air crossed the -14C threshold" },
      { "fact_id": "FACT-012", "statement": "Lori entered cold storage to hide the MNF-IN-4471 short-ship before audit sampling of inbound lot L-4471" },
      { "fact_id": "FACT-013", "statement": "Cleaning lead Pat Nguyen saw the dock door propped and an unidentified person near the cold hall at 23:40 without seeing a face" },
      { "fact_id": "FACT-014", "statement": "The nightly badge log batch upload to the access archive completed at 02:30 due to standard IT sync delay" },
      { "fact_id": "FACT-015", "statement": "If CZ-1 remains above -12C at 05:00, Northline must initiate product write-off and health compliance notification" },
      { "fact_id": "FACT-016", "statement": "Lori intended CMD-CZ1-MUTE-STAGE to silence the door-ajar alarm only and did not understand staging suspension would persist after she left the terminal" },
      { "fact_id": "FACT-017", "statement": "Root cause of product risk is unattended staging suspension from CMD-CZ1-MUTE-STAGE, not the relabeling alone" },
      { "fact_id": "FACT-018", "statement": "Dev left maintenance session SVC-REFRG-MAINT unlocked on engineering workstation CTRL-TERM-02 when CLO-1847 was closed at 18:30" },
      { "fact_id": "FACT-019", "statement": "Carrier proof-of-delivery POD-4471 lists 48 cases on PLT-4471-A for SKU-FBC-12KG batch BATCH-2026-0310-A but receiving recorded only 8 cases on manifest MNF-IN-4471" },
      { "fact_id": "FACT-020", "statement": "Alarm ALM-COLD-DOOR-AJAR activated at 23:18:45 because the cold storage door was held open more than 90 seconds during Lori's relabeling work" },
      { "fact_id": "FACT-021", "statement": "Physical residue in aisle C included adhesive backing for NL-20260312-4471A and a mismatched label print timestamp showing LBL-4471-A re-applied away from its original partial-pallet receipt location" },
      { "fact_id": "FACT-022", "statement": "Lori's WMS reconciliation queue flagged MNF-IN-4471 quantity exception at 22:35 before she began relabeling" }
    ]
  },
