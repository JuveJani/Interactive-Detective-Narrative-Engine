{
  "schema_version": "1.0",
  "adventure_id": "The_Cold_Storage_Alarm",
  "fixed_truth": {
    "culprit_id": "NPC-LORI",
    "motive": "A fuvarozó rövid kézbesítésének elrejtése a MNF-IN-4471 bejövő jegyzéken (40 hiányzó SKU-FBC-12KG eset) a negyedéves raklapcímke-ellenőrzési mintavétel előtt",
    "method": "A Fejlesztő elfelejtett jelvényét használta a hűtőtárolóba való belépéshez, átcímkézte a raklapokat a tételazonosító helytelen hozzárendeléséhez anélkül, hogy hiányzó készletet hozna létre, majd a fejlesztő felügyelet nélküli BMS-karbantartási munkamenetét használta a zóna némítási parancsának kibocsátására, amely felfüggesztette a CZ-1 kompresszor szakaszolását.",
    "opportunity": "A hónap végi manifeszt megbékélés feltárta a rövid hajót; Lorinak volt WMS-hozzáférése, a hűtőház szomszédságában a késői műszakban, és a Dev zárolatlan hűtőkarbantartási munkamenete továbbra is aktív CTRL-TERM-02 napon",
    "immutable_facts": [
      {
        "fact_id": "FACT-001",
        "statement": "A Dev Santos jogszerűen kitöltötte a hűtőkarbantartási jegyet CLO-1847, CZ-1, 18:30"
      },
      {
        "fact_id": "FACT-002",
        "statement": "Dev Santos 19:02-kor hagyta el a létesítményt a kimenő jelvény beolvasásával a rakodókon."
      },
      {
        "fact_id": "FACT-003",
        "statement": "Dev ideiglenes jelvénye belépőkártya-DEV-TEMP a pihenőszoba öltözőszekrényében maradt, miután távozott"
      },
      {
        "fact_id": "FACT-004",
        "statement": "Marcus Hale éjszakai őr vizuálisan megerősítette, hogy a hűtőkamra ajtaja 23:00-kor bereteszelt"
      },
      {
        "fact_id": "FACT-005",
        "statement": "A hűtőház jelvényolvasója 23:14:08-kor naplózott egy bejövő bejegyzést a belépőkártya-DEV-TEMP hitelesítő adatokkal"
      },
      {
        "fact_id": "FACT-006",
        "statement": "Lori eltávolította az LBL-4471-A címkét (NL-20260312-4471A sorozat) a PLT-4471-A 8 tokos részleges raklapról és az LBL-Q118-B címkét a PLT-Q118-B karantén raklapról, majd ráragasztotta az LBL-4471-A címkét és (4471-2) LBL-Q118-B a 8 esetes részleges köteghez, így a WMS-vizsgálatok azt mutatják, hogy az L-4471 tele van a C3-as öbölben, míg a rövid hajó karanténcímke alatt van."
      },
      {
        "fact_id": "FACT-007",
        "statement": "Lori Okonkwo jelvénye belépőkártya-LORI bejelentkezett az automatizálási vezérlőterembe 23:20:41-kor, de Lori nem rendelkezik REFRG_TECH mérnöki jogosultsággal"
      },
      {
        "fact_id": "FACT-008",
        "statement": "BMS terminál CTRL-TERM-02 naplózott parancs CMD-CZ1-MUTE-STAGE 23:22:17-kor karbantartás alatt SVC-REFRG-MAINT; a parancsnapló csak a terminált és a munkamenetet rögzíti, a kezelő személyi jelvényét nem"
      },
      {
        "fact_id": "FACT-009",
        "statement": "CMD-CZ1-MUTE-STAGE felfüggeszti a CZ-1 igény fokozatba állítását és a kompresszor forgását, miközben elnémítja az ajtónyitottság jelzését a kiválasztott zónateszt ablakban"
      },
      {
        "fact_id": "FACT-010",
        "statement": "CZ-1 a befúvott levegő hőmérséklete tartósan emelkedni kezdett 23:27-kor a felfüggesztés után, miközben a hőtömeg elfedte a korai sodródást"
      },
      {
        "fact_id": "FACT-011",
        "statement": "Magas hőmérsékleti riasztás ALM-COLD-HIGH 23:30-kor aktiválódott, amikor CZ-1 befújt levegő átlépte a -14C küszöböt"
      },
      {
        "fact_id": "FACT-012",
        "statement": "Lori belépett a hűtőházba, hogy elrejtse a MNF-IN-4471 rövidzárlatot, mielőtt az L-4471 bejövő tételből auditált mintát vett volna"
      },
      {
        "fact_id": "FACT-013",
        "statement": "A takarítóvezető Pat Nguyen 23:40-kor látta a dokk ajtaját megtámasztva és egy ismeretlen személyt a hűtőcsarnok közelében anélkül, hogy arcot látott volna."
      },
      {
        "fact_id": "FACT-014",
        "statement": "Az éjszakai jelvénynapló kötegelt feltöltése a hozzáférési archívumba 02:30-kor befejeződött a szabványos informatikai szinkronizálási késés miatt"
      },
      {
        "fact_id": "FACT-015",
        "statement": "Ha 05:00-kor a CZ-1 -12C felett marad, a Northline-nak kezdeményeznie kell a termékleírást és az egészségügyi megfelelőségről szóló értesítést"
      },
      {
        "fact_id": "FACT-016",
        "statement": "Lori szándéka szerint CMD-CZ1-MUTE-STAGE csak az ajtónyitott ajtó riasztót akarta elnémítani, és nem értette, hogy a felfüggesztés továbbra is fennáll, miután elhagyta a terminált"
      },
      {
        "fact_id": "FACT-017",
        "statement": "A termékkockázat kiváltó oka a CMD-CZ1-MUTE-STAGE-tól kezdődő, felügyelet nélküli szakaszos felfüggesztés, nem csak az átcímkézés"
      },
      {
        "fact_id": "FACT-018",
        "statement": "A fejlesztő a SVC-REFRG-MAINT karbantartási munkamenetet feloldva hagyta a CTRL-TERM-02 mérnöki munkaállomáson, amikor a CLO-1847 18:30-kor bezárt"
      },
      {
        "fact_id": "FACT-019",
        "statement": "A fuvarozó kézbesítési igazolása POD-4471 48 esetet sorol fel az PLT-4471-A oldalon a SKU-FBC-12KG BATCH-2026-0310-A ​​tételhez, de a fogadó csak 8 esetet rögzített a MNF-IN-4471 jegyzékben"
      },
      {
        "fact_id": "FACT-020",
        "statement": "A ALM-COLD-DOOR-AJAR riasztás 23:18:45-kor aktiválódott, mert a hűtőház ajtaját több mint 90 másodpercig nyitva tartották Lori átcímkézési munkája során"
      },
      {
        "fact_id": "FACT-021",
        "statement": "A C folyosón a fizikai maradványok közé tartozott az NL-20260312-4471A öntapadó hátlapja, valamint egy nem egyező címkenyomtatási időbélyeg, amelyen az LBL-4471-A látható az eredeti részleges raklap átvételi helyétől távol."
      },
      {
        "fact_id": "FACT-022",
        "statement": "Lori WMS-egyeztetési sora MNF-IN-4471 mennyiségi kivételt jelölt meg 22:35-kor, mielőtt elkezdte az átcímkézést"
      }
    ]
  },
