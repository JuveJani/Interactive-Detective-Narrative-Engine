{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idne.dev/schemas/playtime_calibration_finding.schema.json",
  "title": "IDNE Playtime Calibration Finding",
  "type": "object",
  "required": ["finding_id", "severity", "confidence", "player_mode"],
  "properties": {
    "finding_id": { "type": "string" },
    "severity": { "type": "string", "enum": ["critical", "major", "minor"] },
    "confidence": { "type": "string", "enum": ["proven", "likely", "ambiguous"] },
    "player_mode": { "type": "string" },
    "path_or_split": { "type": "string" },
    "predicted_lower_minutes": { "type": "number" },
    "predicted_expected_minutes": { "type": "number" },
    "predicted_upper_minutes": { "type": "number" },
    "target_minutes": { "type": "number" },
    "source_components": { "type": "array", "items": { "type": "string" } },
    "assumption_set": { "type": "string" },
    "error_or_uncertainty": { "type": "string" },
    "gameplay_risk": { "type": "string" },
    "human_measurement_required": { "type": "boolean" },
    "tier": { "type": "string", "enum": ["A", "B", "C"] }
  }
}
