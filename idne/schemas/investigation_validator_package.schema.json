{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idne.dev/schemas/investigation_validator_package.schema.json",
  "title": "IDNE Investigation Validator Package",
  "type": "object",
  "required": ["schema_version", "adventure_id", "play_modes"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "adventure_id": { "type": "string" },
    "play_modes": { "type": "array", "minItems": 1 },
    "layer_links": { "type": "object" },
    "conclusion_traces": { "type": "array" },
    "inference_questions": { "type": "array" },
    "information_sufficiency": { "type": "array" },
    "recovery_routes": { "type": "array" },
    "access_requirements": { "type": "array" },
    "mandatory_check_fairness": { "type": "array" },
    "npc_disclosure_routes": { "type": "array" },
    "time_validation": { "type": "object" },
    "ending_reachability": { "type": "array" },
    "accusation_fairness": { "type": "object" },
    "play_mode_constraints": { "type": "object" },
    "player_audit": { "type": "object" },
    "state_graph_config": { "type": "object" },
    "tier_b_mandatory": { "type": "array" }
  }
}
