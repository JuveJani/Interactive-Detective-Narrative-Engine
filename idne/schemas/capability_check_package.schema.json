{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idne.dev/schemas/capability_check_package.schema.json",
  "title": "IDNE Capability Check Package",
  "type": "object",
  "required": ["schema_version", "adventure_id", "checks", "modifier_sources", "resolution_model"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "adventure_id": { "type": "string" },
    "play_modes": { "type": "array", "items": { "type": "string" } },
    "investigation_core_links": { "type": "object" },
    "object_interaction_links": { "type": "object" },
    "npc_investigation_links": { "type": "object" },
    "environment_links": { "type": "object" },
    "modifier_sources": { "type": "array", "minItems": 1 },
    "resolution_model": {
      "type": "object",
      "required": ["formula", "success_when"],
      "properties": {
        "formula": { "type": "string" },
        "success_when": { "type": "string" }
      }
    },
    "difficulty_bands": {
      "type": "object",
      "properties": {
        "easy": { "type": "number" },
        "medium": { "type": "number" },
        "hard": { "type": "number" }
      }
    },
    "destination_units": { "type": "array" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "player_content_refs": { "type": "object" }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": [
        "check_id",
        "capability",
        "capability_category",
        "dc",
        "dc_justification",
        "destinations",
        "fixed_truth_invariants",
        "attempt_policy"
      ],
      "properties": {
        "check_id": { "type": "string" },
        "parent_action_id": { "type": "string" },
        "parent_action_layer": { "type": "string" },
        "parent_action_type": { "type": "string" },
        "player_action_label": { "type": "string" },
        "capability": { "type": "string" },
        "capability_category": {
          "type": "string",
          "enum": [
            "perception_observation",
            "reasoning_interpretation",
            "technical_operation",
            "physical_strength",
            "agility",
            "social_persuasion",
            "social_intimidation",
            "social_deception"
          ]
        },
        "modifier_source_id": { "type": "string" },
        "dc": { "type": "number" },
        "dc_justification": { "type": "string", "minLength": 1 },
        "why_check_exists": { "type": "string" },
        "attempt_policy": { "type": "object" },
        "destinations": {
          "type": "object",
          "required": ["success_destination", "failure_destination"],
          "properties": {
            "action_unit_id": { "type": "string" },
            "success_destination": { "type": "string" },
            "failure_destination": { "type": "string" }
          }
        },
        "fixed_truth_invariants": { "type": "object" },
        "success_effects": { "type": "object" },
        "failure_effects": { "type": "object" },
        "information_trace": { "type": "object" },
        "eligibility": { "type": "object" }
      }
    }
  }
}
