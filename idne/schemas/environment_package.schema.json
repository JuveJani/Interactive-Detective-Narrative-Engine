{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idne.dev/schemas/environment_package.schema.json",
  "title": "IDNE Environment Package",
  "type": "object",
  "required": [
    "schema_version",
    "adventure_id",
    "locations",
    "location_states",
    "features",
    "navigation",
    "state_transitions",
    "revisit_rules"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "adventure_id": { "type": "string" },
    "start_location_id": { "type": "string" },
    "world_first_links": {
      "type": "object",
      "properties": {
        "truth_package_path": { "type": "string" }
      }
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/location" }
    },
    "location_states": {
      "type": "array",
      "items": { "$ref": "#/$defs/location_state" }
    },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/feature" }
    },
    "navigation": {
      "type": "array",
      "items": { "$ref": "#/$defs/navigation" }
    },
    "state_transitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/state_transition" }
    },
    "revisit_rules": { "$ref": "#/$defs/revisit_rules" },
    "mandatory_locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["location_id"],
        "properties": {
          "location_id": { "type": "string" },
          "access": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "player_content_refs": {
      "type": "object",
      "properties": {
        "files": { "type": "array", "items": { "type": "string" } },
        "exposed_feature_ids": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "cause": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["initial", "timeline_event", "world_time", "player_action", "npc_action", "always"]
        },
        "ref": { "type": "string" }
      }
    },
    "location": {
      "type": "object",
      "required": ["location_id", "public_name", "location_type", "state_owner"],
      "properties": {
        "location_id": { "type": "string" },
        "public_name": { "type": "string" },
        "parent_location_id": { "type": ["string", "null"] },
        "location_type": { "type": "string" },
        "description_source": { "type": "string" },
        "world_first_provenance": { "type": "object" },
        "state_owner": { "type": "string", "const": "environment_package" }
      }
    },
    "location_state": {
      "type": "object",
      "required": ["state_id", "location_id", "cause"],
      "properties": {
        "state_id": { "type": "string" },
        "location_id": { "type": "string" },
        "variant_label": { "type": "string" },
        "attributes": { "type": "object" },
        "cause": { "$ref": "#/$defs/cause" },
        "active_from_clock": { "type": "string" },
        "trigger_event_id": { "type": ["string", "null"] }
      }
    },
    "feature": {
      "type": "object",
      "required": ["feature_id", "location_id", "visibility", "broad_state"],
      "properties": {
        "feature_id": { "type": "string" },
        "location_id": { "type": "string" },
        "feature_type": { "type": "string" },
        "visibility": {
          "type": "string",
          "enum": [
            "known_remotely",
            "on_arrival",
            "after_entering",
            "approach_feature",
            "hidden_until_interaction"
          ]
        },
        "broad_state": { "type": "string" },
        "has_further_interaction": { "type": "boolean" },
        "world_first_provenance": { "type": "object" }
      }
    },
    "navigation": {
      "type": "object",
      "required": [
        "nav_id",
        "source_location_id",
        "destination_location_id",
        "player_label"
      ],
      "properties": {
        "nav_id": { "type": "string" },
        "source_location_id": { "type": "string" },
        "destination_location_id": { "type": "string" },
        "player_label": { "type": "string", "minLength": 3 },
        "travel_cost_minutes": { "type": "number" },
        "access_condition": { "type": "object" },
        "return_nav_id": { "type": "string" },
        "one_way_justification": { "type": "string" },
        "requires_return_route": { "type": "boolean" },
        "mandatory": { "type": "boolean" },
        "hidden_destination_id": { "type": "string" }
      }
    },
    "state_transition": {
      "type": "object",
      "required": ["transition_id", "location_id", "cause"],
      "properties": {
        "transition_id": { "type": "string" },
        "location_id": { "type": "string" },
        "from_state_id": { "type": "string" },
        "to_state_id": { "type": "string" },
        "cause": { "$ref": "#/$defs/cause" },
        "persists_on_revisit": { "type": "boolean" },
        "resets_on_revisit": { "type": "boolean" }
      }
    },
    "revisit_rules": {
      "type": "object",
      "required": [
        "persist_physical_changes",
        "persist_acquired_objects",
        "persist_open_access",
        "suppress_repeat_one_time_observations",
        "allow_time_variants"
      ],
      "properties": {
        "persist_physical_changes": { "type": "boolean" },
        "persist_acquired_objects": { "type": "boolean" },
        "persist_open_access": { "type": "boolean" },
        "suppress_repeat_one_time_observations": { "type": "boolean" },
        "allow_time_variants": { "type": "boolean" },
        "reset_to_initial_on_revisit": { "type": "boolean" }
      }
    }
  }
}
