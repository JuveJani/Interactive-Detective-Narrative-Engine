{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idne.dev/schemas/story_validator_package.schema.json",
  "title": "IDNE Story Validator Package",
  "type": "object",
  "required": ["schema_version", "adventure_id", "play_modes", "story_frame"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "adventure_id": { "type": "string" },
    "play_modes": { "type": "array", "minItems": 1 },
    "story_frame": { "type": "object" },
    "timeline": { "type": "object" },
    "causal_events": { "type": "array" },
    "information_facts": { "type": "array" },
    "knowledge_order": { "type": "array" },
    "npc_consistency": { "type": "array" },
    "location_object_continuity": { "type": "array" },
    "narrative_neutrality": { "type": "array" },
    "inference_questions": { "type": "array" },
    "opening_transitions": { "type": "array" },
    "ending_story": { "type": "array" },
    "plain_language": { "type": "object" },
    "player_audit": { "type": "object" },
    "play_mode_constraints": { "type": "object" },
    "tier_b_mandatory": { "type": "array" }
  }
}
