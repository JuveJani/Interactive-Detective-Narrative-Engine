{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idne.dev/schemas/story_validator_finding.schema.json",
  "title": "IDNE Story Validator Finding",
  "type": "object",
  "required": ["finding_id", "severity", "confidence", "layer"],
  "properties": {
    "finding_id": { "type": "string" },
    "severity": { "type": "string", "enum": ["critical", "major", "minor"] },
    "confidence": { "type": "string", "enum": ["proven", "likely", "ambiguous"] },
    "layer": { "type": "string" },
    "source_file": { "type": "string" },
    "entity_id": { "type": "string" },
    "player_excerpt": { "type": "string" },
    "expected_canonical": { "type": "string" },
    "observed_issue": { "type": "string" },
    "affected_question": { "type": "string" },
    "affected_conclusion": { "type": "string" },
    "affected_ending": { "type": "string" },
    "script_detectable": { "type": "boolean" },
    "tier": { "type": "string", "enum": ["A", "B", "C"] },
    "suggested_review_action": { "type": "string" },
    "human_approval_needed": { "type": "boolean" }
  }
}
