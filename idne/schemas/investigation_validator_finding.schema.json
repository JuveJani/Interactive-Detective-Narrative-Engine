{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idne.dev/schemas/investigation_validator_finding.schema.json",
  "title": "IDNE Investigation Validator Finding",
  "type": "object",
  "required": ["finding_id", "severity", "confidence", "layer"],
  "properties": {
    "finding_id": { "type": "string" },
    "severity": { "type": "string", "enum": ["critical", "major", "minor"] },
    "confidence": { "type": "string", "enum": ["proven", "likely", "ambiguous"] },
    "layer": { "type": "string" },
    "source_file": { "type": "string" },
    "canonical_id": { "type": "string" },
    "broken_trace": { "type": "array", "items": { "type": "string" } },
    "expected_rule": { "type": "string" },
    "actual_state": { "type": "string" },
    "affected_conclusions": { "type": "array", "items": { "type": "string" } },
    "affected_endings": { "type": "array", "items": { "type": "string" } },
    "suggested_review_action": { "type": "string" },
    "automatically_fixable": { "type": "boolean" },
    "human_approval_needed": { "type": "boolean" },
    "tier": { "type": "string", "enum": ["A", "B", "C"] }
  }
}
